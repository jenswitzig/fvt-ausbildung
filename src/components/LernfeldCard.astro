---
interface Props {
  nummer: number;
  kuerzel: string;
  titel: string;
  beschreibung: string;
  stunden: number;
  slug: string;
  farbe?: string;
}

const { nummer, kuerzel, titel, beschreibung, stunden, slug, farbe = "amber" } = Astro.props;

const colorMap: Record<string, { badge: string; border: string; icon: string }> = {
  amber:  { badge: "bg-amber-500/15 text-amber-400",  border: "border-amber-500/20 hover:border-amber-500/50",  icon: "text-amber-400" },
  yellow: { badge: "bg-yellow-500/15 text-yellow-400", border: "border-yellow-500/20 hover:border-yellow-500/50", icon: "text-yellow-400" },
  blue:   { badge: "bg-blue-500/15 text-blue-400",    border: "border-blue-500/20 hover:border-blue-500/50",    icon: "text-blue-400" },
  red:    { badge: "bg-red-500/15 text-red-400",      border: "border-red-500/20 hover:border-red-500/50",      icon: "text-red-400" },
  green:  { badge: "bg-green-500/15 text-green-400",  border: "border-green-500/20 hover:border-green-500/50",  icon: "text-green-400" },
  rose:   { badge: "bg-rose-500/15 text-rose-400",    border: "border-rose-500/20 hover:border-rose-500/50",    icon: "text-rose-400" },
  cyan:   { badge: "bg-cyan-500/15 text-cyan-400",    border: "border-cyan-500/20 hover:border-cyan-500/50",    icon: "text-cyan-400" },
  violet: { badge: "bg-violet-500/15 text-violet-400",border: "border-violet-500/20 hover:border-violet-500/50",icon: "text-violet-400" },
};

const colors = colorMap[farbe] ?? colorMap.amber;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a
  href={`${base}/lernfelder/${slug}`}
  class:list={[
    "group block bg-slate-900 border rounded-xl p-5 transition-all duration-200 hover:bg-slate-800/80 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/20",
    colors.border
  ]}
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <span class:list={["inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-semibold", colors.badge]}>
      {kuerzel}
    </span>
    <span class="text-xs text-slate-500 flex items-center gap-1">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      {stunden} Std.
    </span>
  </div>

  <h3 class="font-semibold text-slate-100 mb-2 group-hover:text-white transition-colors leading-snug">
    {titel}
  </h3>

  <p class="text-sm text-slate-400 leading-relaxed line-clamp-3">
    {beschreibung}
  </p>

  <div class:list={["mt-4 flex items-center gap-1 text-xs font-medium transition-colors", colors.icon]}>
    <span>Lerninhalte öffnen</span>
    <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
