---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname;

// Determine current track
const isFvt = pathname.includes('/fvt');
const isFachwirt = pathname.includes('/fachwirt');
const isMeister = pathname.includes('/meister');

type NavLink = { href: string; label: string };

let trackLinks: NavLink[] = [];
let trackColor = "amber";
let trackLabel = "";
let trackKuerzel = "";

if (isFvt) {
  trackLabel = "FVT";
  trackKuerzel = "FVT";
  trackColor = "amber";
  trackLinks = [
    { href: `${base}/fvt`, label: "Übersicht" },
    { href: `${base}/fvt/lernfelder`, label: "Lernfelder" },
    { href: `${base}/fvt/pruefung`, label: "Prüfung" },
    { href: `${base}/fvt/quiz`, label: "Quiz" },
  ];
} else if (isFachwirt) {
  trackLabel = "Fachwirt";
  trackKuerzel = "FW";
  trackColor = "blue";
  trackLinks = [
    { href: `${base}/fachwirt`, label: "Übersicht" },
    { href: `${base}/fachwirt/sachgebiete`, label: "Sachgebiete" },
    { href: `${base}/fachwirt/pruefung`, label: "Prüfung" },
    { href: `${base}/fachwirt/quiz`, label: "Quiz" },
  ];
} else if (isMeister) {
  trackLabel = "Meister";
  trackKuerzel = "MEI";
  trackColor = "emerald";
  trackLinks = [
    { href: `${base}/meister`, label: "Übersicht" },
    { href: `${base}/meister/sachgebiete`, label: "Sachgebiete" },
    { href: `${base}/meister/pruefung`, label: "Prüfung" },
    { href: `${base}/meister/quiz`, label: "Quiz" },
  ];
}

const isInTrack = isFvt || isFachwirt || isMeister;

const colorMap: Record<string, { bg: string; text: string; activeBg: string; activeText: string }> = {
  amber: { bg: "bg-amber-500", text: "text-slate-900", activeBg: "bg-amber-500/10", activeText: "text-amber-400" },
  blue: { bg: "bg-blue-500", text: "text-white", activeBg: "bg-blue-500/10", activeText: "text-blue-400" },
  emerald: { bg: "bg-emerald-500", text: "text-white", activeBg: "bg-emerald-500/10", activeText: "text-emerald-400" },
};

const colors = colorMap[trackColor] ?? colorMap.amber;
---

<nav class="bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="flex items-center gap-3">
        <a href={`${base}/`} class="flex items-center gap-2 group">
          <div class="w-8 h-8 rounded-lg bg-slate-200 dark:bg-slate-700 flex items-center justify-center font-bold text-slate-600 dark:text-slate-300 text-xs tracking-tight group-hover:bg-slate-300 dark:group-hover:bg-slate-600 transition-colors">
            VA
          </div>
          <span class="font-semibold text-slate-500 dark:text-slate-400 hidden sm:block text-sm hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
            Veranstaltungstechnik
          </span>
        </a>

        {isInTrack && (
          <div class="flex items-center gap-2">
            <span class="text-slate-700">/</span>
            <a
              href={isFvt ? `${base}/fvt` : isFachwirt ? `${base}/fachwirt` : `${base}/meister`}
              class:list={["flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold transition-colors", colors.bg, colors.text]}
            >
              {trackKuerzel}
            </a>
          </div>
        )}
      </div>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-1">
        {isInTrack ? (
          trackLinks.map(link => (
            <a
              href={link.href}
              class:list={[
                "px-4 py-2 rounded-lg text-sm font-medium transition-colors",
                (pathname === link.href || (link.label !== "Übersicht" && pathname.startsWith(link.href)))
                  ? [colors.activeBg, colors.activeText]
                  : "text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800"
              ]}
            >
              {link.label}
            </a>
          ))
        ) : (
          <>
            <a
              href={`${base}/fvt`}
              class:list={[
                "px-3 py-2 rounded-lg text-sm font-medium transition-colors",
                pathname.includes('/fvt') ? "bg-amber-500/10 text-amber-400" : "text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800"
              ]}
            >
              FVT
            </a>
            <a
              href={`${base}/fachwirt`}
              class:list={[
                "px-3 py-2 rounded-lg text-sm font-medium transition-colors",
                pathname.includes('/fachwirt') ? "bg-blue-500/10 text-blue-400" : "text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800"
              ]}
            >
              Fachwirt
            </a>
            <a
              href={`${base}/meister`}
              class:list={[
                "px-3 py-2 rounded-lg text-sm font-medium transition-colors",
                pathname.includes('/meister') ? "bg-emerald-500/10 text-emerald-400" : "text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800"
              ]}
            >
              Meister
            </a>
            <a
              href={`${base}/vergleich`}
              class:list={[
                "px-3 py-2 rounded-lg text-sm font-medium transition-colors",
                pathname.includes('/vergleich') ? "bg-slate-700 text-slate-200" : "text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800"
              ]}
            >
              Vergleich
            </a>
          </>
        )}
      </div>

      <!-- Theme toggle + Mobile menu button -->
      <div class="flex items-center gap-1">
        <button
          id="theme-toggle"
          class="p-2 rounded-lg text-slate-400 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          aria-label="Theme wechseln"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg id="icon-sun" class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg id="icon-moon" class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          aria-label="Menü öffnen"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav -->
    <div id="mobile-menu" class="md:hidden hidden pb-4 border-t border-slate-200 dark:border-slate-800 mt-0 pt-3">
      {isInTrack ? (
        trackLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              "block px-3 py-2.5 rounded-lg text-sm font-medium transition-colors mb-1",
              (pathname === link.href || (link.label !== "Übersicht" && pathname.startsWith(link.href)))
                ? [colors.activeBg, colors.activeText]
                : "text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800"
            ]}
          >
            {link.label}
          </a>
        ))
      ) : (
        <>
          <a href={`${base}/fvt`} class="block px-3 py-2.5 rounded-lg text-sm font-medium text-slate-400 hover:text-slate-100 hover:bg-slate-800 transition-colors mb-1">FVT</a>
          <a href={`${base}/fachwirt`} class="block px-3 py-2.5 rounded-lg text-sm font-medium text-slate-400 hover:text-slate-100 hover:bg-slate-800 transition-colors mb-1">Fachwirt</a>
          <a href={`${base}/meister`} class="block px-3 py-2.5 rounded-lg text-sm font-medium text-slate-400 hover:text-slate-100 hover:bg-slate-800 transition-colors mb-1">Meister</a>
          <a href={`${base}/vergleich`} class="block px-3 py-2.5 rounded-lg text-sm font-medium text-slate-400 hover:text-slate-100 hover:bg-slate-800 transition-colors mb-1">Vergleich</a>
        </>
      )}

      {isInTrack && (
        <div class="mt-3 pt-3 border-t border-slate-200 dark:border-slate-800">
          <a href={`${base}/`} class="block px-3 py-2 text-xs text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-400 transition-colors">
            ← Alle Qualifikationen
          </a>
        </div>
      )}
    </div>
  </div>
</nav>

<script>
  // Mobile menu
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      document.documentElement.classList.add('light');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.remove('light');
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });
</script>
