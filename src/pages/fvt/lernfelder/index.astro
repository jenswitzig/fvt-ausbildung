---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import { getCollection } from 'astro:content';

const lernfelder = await getCollection('lernfelder');
const sorted = lernfelder.sort((a, b) => a.data.nummer - b.data.nummer);
const gesamtStunden = sorted.reduce((acc, lf) => acc + lf.data.stunden, 0);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const colorMap: Record<string, { badge: string; border: string; icon: string }> = {
  amber:  { badge: "bg-amber-500/15 text-amber-400",  border: "border-amber-500/20 hover:border-amber-500/50",  icon: "text-amber-400" },
  yellow: { badge: "bg-yellow-500/15 text-yellow-400", border: "border-yellow-500/20 hover:border-yellow-500/50", icon: "text-yellow-400" },
  blue:   { badge: "bg-blue-500/15 text-blue-400",    border: "border-blue-500/20 hover:border-blue-500/50",    icon: "text-blue-400" },
  red:    { badge: "bg-red-500/15 text-red-400",      border: "border-red-500/20 hover:border-red-500/50",      icon: "text-red-400" },
  green:  { badge: "bg-green-500/15 text-green-400",  border: "border-green-500/20 hover:border-green-500/50",  icon: "text-green-400" },
  rose:   { badge: "bg-rose-500/15 text-rose-400",    border: "border-rose-500/20 hover:border-rose-500/50",    icon: "text-rose-400" },
  cyan:   { badge: "bg-cyan-500/15 text-cyan-400",    border: "border-cyan-500/20 hover:border-cyan-500/50",    icon: "text-cyan-400" },
  violet: { badge: "bg-violet-500/15 text-violet-400",border: "border-violet-500/20 hover:border-violet-500/50",icon: "text-violet-400" },
};
---

<Layout title="FVT Lernfelder" description="Übersicht aller 8 Lernfelder der FVT-Ausbildung.">
  <Nav slot="nav" />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-12">
      <nav class="text-sm text-slate-500 mb-4">
        <a href={`${base}/`} class="hover:text-slate-300 transition-colors">Start</a>
        <span class="mx-2">/</span>
        <a href={`${base}/fvt`} class="hover:text-slate-300 transition-colors">FVT</a>
        <span class="mx-2">/</span>
        <span class="text-slate-300">Lernfelder</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-100 mb-3">Lernfelder</h1>
      <p class="text-slate-400 text-lg max-w-2xl leading-relaxed">
        Die FVT-Ausbildung gliedert sich in 8 Lernfelder mit insgesamt <span class="text-amber-400 font-semibold">{gesamtStunden} Unterrichtsstunden</span>.
        Klicke auf ein Lernfeld für detaillierte Inhalte.
      </p>
    </div>

    <div class="mb-10 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-slate-800">
            <th class="text-left py-3 px-4 text-slate-400 font-medium">Kürzel</th>
            <th class="text-left py-3 px-4 text-slate-400 font-medium">Titel</th>
            <th class="text-right py-3 px-4 text-slate-400 font-medium">Stunden</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map(lf => (
            <tr class="border-b border-slate-800/50 hover:bg-slate-900/50 transition-colors">
              <td class="py-3 px-4">
                <span class="font-mono text-xs font-semibold text-amber-400 bg-amber-500/10 px-2 py-1 rounded">{lf.data.kuerzel}</span>
              </td>
              <td class="py-3 px-4">
                <a href={`${base}/fvt/lernfelder/${lf.id}`} class="text-slate-300 hover:text-amber-400 transition-colors font-medium">
                  {lf.data.titel}
                </a>
              </td>
              <td class="py-3 px-4 text-right text-slate-400">{lf.data.stunden}</td>
            </tr>
          ))}
          <tr class="bg-slate-900/50">
            <td colspan="2" class="py-3 px-4 text-slate-300 font-semibold">Gesamt</td>
            <td class="py-3 px-4 text-right text-amber-400 font-bold">{gesamtStunden}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {sorted.map(lf => {
        const colors = colorMap[lf.data.farbe ?? 'amber'] ?? colorMap.amber;
        return (
          <a
            href={`${base}/fvt/lernfelder/${lf.id}`}
            class:list={["group block bg-slate-900 border rounded-xl p-5 transition-all duration-200 hover:bg-slate-800/80 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/20", colors.border]}
          >
            <div class="flex items-start justify-between gap-3 mb-3">
              <span class:list={["inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-semibold", colors.badge]}>
                {lf.data.kuerzel}
              </span>
              <span class="text-xs text-slate-500 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {lf.data.stunden} Std.
              </span>
            </div>
            <h3 class="font-semibold text-slate-100 mb-2 group-hover:text-white transition-colors leading-snug">{lf.data.titel}</h3>
            <p class="text-sm text-slate-400 leading-relaxed line-clamp-3">{lf.data.beschreibung}</p>
            <div class:list={["mt-4 flex items-center gap-1 text-xs font-medium transition-colors", colors.icon]}>
              <span>Lerninhalte öffnen</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
