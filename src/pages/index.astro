---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import LernfeldCard from '../components/LernfeldCard.astro';
import { getCollection } from 'astro:content';

const lernfelder = await getCollection('lernfelder');
const sorted = lernfelder.sort((a, b) => a.data.nummer - b.data.nummer);

const stats = [
  { label: "Lernfelder", value: "8" },
  { label: "Prüfungsfragen", value: "48+" },
  { label: "Unterrichtsstunden", value: "720" },
  { label: "Ausbildungsjahre", value: "3" },
];

const features = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`,
    titel: "Lernfelder",
    text: "8 vollständige Lernfelder mit praxisnahen Inhalten zu Elektrotechnik, Licht, Ton, Bühnentechnik und mehr."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />`,
    titel: "Prüfungsvorbereitung",
    text: "Strukturierte Übersicht aller relevanten Themen für Zwischen- und Abschlussprüfung."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
    titel: "Interaktives Quiz",
    text: "48+ Fragen mit sofortigem Feedback. Filtere nach Lernfeld und tracke deinen Fortschritt."
  },
];
---

<Layout title="Startseite">
  <Nav slot="nav" />

  <!-- Hero -->
  <section class="relative bg-slate-950 overflow-hidden">
    <!-- Background grid -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-30"></div>
    <!-- Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[60rem] h-[30rem] bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-24 pb-20 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-amber-500/10 border border-amber-500/20 rounded-full text-amber-400 text-xs font-semibold tracking-wide mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        Ausbildung · Veranstaltungstechnik
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-100 leading-tight mb-6">
        Fachkraft für
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-500">
          Veranstaltungstechnik
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        Deine Lernplattform für die FVT-Ausbildung. Alle Lernfelder, interaktive Quizfragen
        und Prüfungsvorbereitung – kompakt und verständlich.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/lernfelder"
          class="px-6 py-3 bg-amber-500 hover:bg-amber-400 text-slate-900 font-semibold rounded-xl transition-colors"
        >
          Lernfelder erkunden
        </a>
        <a
          href="/quiz"
          class="px-6 py-3 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-xl transition-colors border border-slate-700"
        >
          Quiz starten
        </a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-slate-800 bg-slate-900/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8">
        {stats.map(stat => (
          <div class="text-center">
            <div class="text-3xl font-bold text-amber-400 mb-1">{stat.value}</div>
            <div class="text-sm text-slate-400">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
    <div class="text-center mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-3">Was dich erwartet</h2>
      <p class="text-slate-400 max-w-xl mx-auto">Alles, was du für eine erfolgreiche FVT-Ausbildung brauchst.</p>
    </div>
    <div class="grid sm:grid-cols-3 gap-6">
      {features.map(f => (
        <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl">
          <div class="w-10 h-10 bg-amber-500/10 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={f.icon} />
          </div>
          <h3 class="font-semibold text-slate-100 mb-2">{f.titel}</h3>
          <p class="text-sm text-slate-400 leading-relaxed">{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Lernfelder Preview -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-20">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-1">Lernfelder</h2>
        <p class="text-slate-400 text-sm">Alle 8 Lernfelder der FVT-Ausbildung</p>
      </div>
      <a href="/lernfelder" class="text-sm text-amber-400 hover:text-amber-300 font-medium flex items-center gap-1">
        Alle anzeigen
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {sorted.map(lf => (
        <LernfeldCard
          nummer={lf.data.nummer}
          kuerzel={lf.data.kuerzel}
          titel={lf.data.titel}
          beschreibung={lf.data.beschreibung}
          stunden={lf.data.stunden}
          slug={lf.slug}
          farbe={lf.data.farbe}
        />
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-slate-900 border-t border-slate-800 py-20">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-4">Bereit für die Prüfung?</h2>
      <p class="text-slate-400 mb-8">Teste dein Wissen mit über 48 praxisnahen Prüfungsfragen aus allen Lernfeldern.</p>
      <a
        href="/quiz"
        class="inline-flex items-center gap-2 px-6 py-3 bg-amber-500 hover:bg-amber-400 text-slate-900 font-semibold rounded-xl transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Quiz jetzt starten
      </a>
    </div>
  </section>
</Layout>
